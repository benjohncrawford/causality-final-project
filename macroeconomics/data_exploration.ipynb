   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv(\"..\\\\data\\\\finance_economics_dataset.csv\")\n",
    "df['Date'] = pd.to_datetime(df['Date'])\n",
    "df.set_index('Date', inplace=True)\n",
    "yearly_df = df[\"Unemployment Rate (%)\"].resample('YE').mean()\n",
    "\n",
    "\n",
    "yearly_df.plot(x=\"Date\",y=\"Unemployment Rate (%)\")"
   ]
  }
